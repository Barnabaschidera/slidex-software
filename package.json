{
  "name": "slidex",
  "version": "1.0.0",
  "description": "Slidex presentation app",
  "author": "Barnabas",
  "main": "main.js",
  "scripts": { "start": "electron .", "dist": "electron-builder --publish never" },
  "dependencies": { "pptxgenjs": "^3.12.0" },
  "devDependencies": { "electron": "^33.2.0", "electron-builder": "^25.1.8" },
  "build": {
    "appId": "com.example.slidex",
    "productName": "Slidex",
    "files": ["main.js", "preload.js", "pptx.js", "index.html"],
    "win": { "target": "nsis" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "mac": { "target": "dmg", "category": "public.app-category.productivity", "identity": null }
  }
}
